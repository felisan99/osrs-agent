# --- Database: any Postgres with pgvector ------------------------------------------------------
# Homebrew Postgres 17 (trust auth, connects as your macOS user):
SUPABASE_DB_URL=postgresql://127.0.0.1:5432/osrs_agent
# Supabase CLI local database instead:  postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Models ------------------------------------------------------------------------------------
# Verified on OpenRouter 2026-10-14: supports tools + structured outputs. Configurable on purpose.
REASONING_MODEL=deepseek/deepseek-v4-flash
# Pinned version: `~typesafe/jev-latest` moves and would shift the probabilities the thresholds
# below are tuned against. The response's `model` field reports the exact version that answered.
JEV_MODEL=typesafe/jev-1.13
# Changing the embedding model means rebuilding the whole index (the vectors of two models are not
# comparable, and the API refuses to start against an index built with another one):
#   uv run python -m scripts.ingest load --force
# Prefix conventions (E5 "query: "/"passage: ", BGE's query instruction, ...) are chosen from the
# model name; set these only to override them ("" = no prefix).
EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-s
EMBEDDING_DIM=384
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_PASSAGE_PREFIX=

# --- Wiki prices API ---------------------------------------------------------------------------
# REQUIRED to be descriptive: describe the tool and add a contact. Generic user agents
# (python-requests, curl/x, Java/x, ...) are blocked by the API.
PRICES_USER_AGENT=osrs-agent-dev - you@example.com

# --- Grand Exchange tax (verified 2026-10-14) --------------------------------------------------
# 2% since 29 May 2025, rounded down per item, 5,000,000 cap per item, charged on the sell side.
GE_TAX_RATE=0.02
GE_TAX_CAP=5000000

# --- CRAG and routing (tuned with the end-to-end eval: docs/eval-m8.md) -------------------------
REL_THRESHOLD=0.70
SUFFICIENCY_THRESHOLD=0.60
CRAG_TOPK=20
MAX_CRAG_ITERATIONS=2
# Below this Jev confidence the router falls back to wiki_general; rejecting as out_of_domain
# needs OUT_OF_DOMAIN_MIN_PROB.
ROUTE_MIN_CONFIDENCE=0.45
OUT_OF_DOMAIN_MIN_PROB=0.80

# --- Money making (rank_moneymakers, docs/moneymakers.md) ---------------------------------------
# mid = midpoint of the high/low prices (reproduces the wiki's own figures); patient = sell at
# the high side, buy at the low side (optimistic); instant = the opposite (pessimistic).
MM_PRICE_BASIS=mid
# Largest share of an item's hourly market volume one player is assumed to trade.
MM_MARKET_SHARE=0.25

# --- HTTP API (docs/api-m6.md) --------------------------------------------------------------------
# The server listens on loopback only. CORS is closed unless origins are listed (JSON list).
HOST=127.0.0.1
PORT=8000
# CORS_ALLOW_ORIGINS=["http://localhost:3000"]
MAX_MESSAGE_CHARS=4000
MAX_PLAYER_STATE_BYTES=256000
# Conversation memory: a thread keeps its latest checkpoint and at most 40 messages; threads idle
# for this many days are deleted (start-up and every 6 hours). 0 = keep forever.
THREAD_TTL_DAYS=30
DEBUG_RESPONSES=false

# --- Developer scripts ONLY (m1_smoke, ingestion LLM extraction, eval) ------------------------
# Put the key in backend/.env or in the repository root's .env (both are found, whatever the
# working directory). `OPENROUTER_API_KEY` works as an alias. The API server never reads it: it
# only ever sees the user's key via X-OpenRouter-Key. Use a key with a spending cap and expiry.
# OPEN_ROUTER_KEY=sk-or-...

# --- LLM behaviour ------------------------------------------------------------------------------
# DeepSeek V4 "thinks" by default and bills the hidden tokens; leave "none" for direct answers.
REASONING_EFFORT=none
LLM_MAX_TOKENS=1500
